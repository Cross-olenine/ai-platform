{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "model.schema.json",
  "title": "Entrée du catalogue des modèles (CAT-01, CAT-04)",
  "type": "object",
  "additionalProperties": false,
  "required": ["alias", "owner", "status", "provider", "model", "model_version", "model_format", "deployment_name", "deployment_type", "region", "protocol", "max_request_kb", "pricing", "limits", "offers", "end_of_support", "review_date"],
  "properties": {
    "alias": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,40}$"},
    "kind": {"enum": ["chat", "embedding"], "default": "chat", "description": "ADR-19 : nature du modèle. Absent = chat. Un embedding est exposé par la route /embeddings."},
    "owner": {"type": "string", "minLength": 2},
    "status": {"enum": ["draft", "active", "deprecated"]},
    "provider": {"const": "azure"},
    "model": {"type": "string", "minLength": 1},
    "model_version": {"type": "string", "minLength": 1},
    "model_format": {"type": "string", "minLength": 1},
    "deployment_name": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{1,63}$"},
    "deployment_type": {"enum": ["DataZoneStandard"], "description": "ADR-03 : seul le type Data Zone EU est autorisé"},
    "region": {"type": "string"},
    "protocol": {"enum": ["responses", "embeddings"], "description": "ADR-06 (chat : responses), ADR-19 (embedding : embeddings)"},
    "context_window": {"type": "integer", "minimum": 0},
    "max_output_tokens": {"type": "integer", "minimum": 1, "description": "Requis pour un chat ; sans objet pour un embedding."},
    "max_request_kb": {"type": "integer", "minimum": 1, "maximum": 4096},
    "capabilities": {"type": "array", "items": {"type": "string"}},
    "pricing": {
      "type": "object", "additionalProperties": false,
      "required": ["input"],
      "properties": {
        "input": {"type": "number", "minimum": 0},
        "cached_input": {"type": "number", "minimum": 0},
        "output": {"type": "number", "minimum": 0}
      }
    },
    "limits": {
      "type": "object", "additionalProperties": false,
      "required": ["capacity_thousand_tpm"],
      "properties": {
        "capacity_thousand_tpm": {
          "description": "Capacité du déploiement par environnement, en milliers de tokens par minute. Le quota de l'abonnement est partagé entre environnements.",
          "type": "object",
          "required": ["dev", "prod"],
          "additionalProperties": {"type": "integer", "minimum": 1}
        }
      }
    },
    "fallback_alias": {"type": "string"},
    "offers": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "end_of_support": {"type": "string", "format": "date"},
    "review_date": {"type": "string", "format": "date"}
  },
  "allOf": [
    {
      "description": "Chat : protocole Responses (ADR-06), plafond de sortie et tarifs complets",
      "if": {"not": {"required": ["kind"], "properties": {"kind": {"const": "embedding"}}}},
      "then": {
        "required": ["max_output_tokens"],
        "properties": {
          "protocol": {"const": "responses"},
          "pricing": {"required": ["input", "cached_input", "output"]}
        }
      }
    },
    {
      "description": "Embedding : API Embeddings (ADR-19), pas de tokens de sortie",
      "if": {"required": ["kind"], "properties": {"kind": {"const": "embedding"}}},
      "then": {
        "properties": {
          "protocol": {"const": "embeddings"},
          "pricing": {"properties": {"output": {"const": 0}}}
        }
      }
    },
    {
      "description": "CAT-04 : un modèle actif a un modèle choisi, un tarif et une limite",
      "if": {"properties": {"status": {"const": "active"}}},
      "then": {
        "properties": {
          "model": {"not": {"const": "A_CHOISIR"}},
          "model_version": {"not": {"const": "A_CHOISIR"}},
          "context_window": {"minimum": 1},
          "pricing": {"properties": {"input": {"exclusiveMinimum": 0}}}
        },
        "required": ["context_window"]
      }
    },
    {
      "description": "CAT-04 : un chat actif a aussi un tarif de sortie",
      "if": {"properties": {"status": {"const": "active"}}, "not": {"required": ["kind"], "properties": {"kind": {"const": "embedding"}}}},
      "then": {"properties": {"pricing": {"properties": {"output": {"exclusiveMinimum": 0}}}}}
    }
  ]
}
