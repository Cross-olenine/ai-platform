{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agent.schema.json",
  "title": "Fiche d'agent (AGT-01, CAT-04) — utilisée à partir de la phase agents de la V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "version", "owner", "class", "target_maturity", "runtime", "model_alias", "instructions_file", "quotas", "companies", "evaluation", "retention_days"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,40}$"},
    "version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
    "owner": {"type": "string", "minLength": 2},
    "class": {"enum": ["C1", "C2"]},
    "target_maturity": {"enum": ["N0", "N1", "N2", "N3", "N4"]},
    "runtime": {"const": "managed"},
    "model_alias": {"type": "string"},
    "instructions_file": {"type": "string"},
    "quotas": {"type": "object", "required": ["max_tokens_per_session"], "properties": {"max_tokens_per_session": {"type": "integer", "minimum": 1}}},
    "companies": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "success_signal": {"type": "string"},
    "evaluation": {
      "type": "object", "required": ["dataset", "thresholds"],
      "properties": {
        "dataset": {"type": "string", "minLength": 1},
        "thresholds": {"type": "object", "required": ["global_success", "critical_success"]}
      }
    },
    "retention_days": {"type": "integer", "minimum": 1},
    "tools": {"type": "array", "maxItems": 0},
    "sources": {"type": "array", "maxItems": 0},
    "memory": {"const": "none"}
  }
}
